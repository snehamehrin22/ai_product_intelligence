  "schema_notes": {
    "platform_events": {
      "event_id": "UUID (string) - Unique event identifier",
      "event_name": "String - Event type (task_created, agent_message_sent, etc.)",
      "event_timestamp": "ISO 8601 timestamp - When event occurred",
      "session_id": "UUID (string) - Session identifier (JOIN KEY with agent_traces)",
      "user_id": "String - User identifier",
      "properties": "JSON object - Event-specific data (flexible schema)"
    },
    "agent_traces": {
      "trace_id": "Hex string (32 chars) - OpenTelemetry trace ID",
      "span_id": "Hex string (16 chars) - OpenTelemetry span ID",
      "parent_span_id": "Hex string or null - Parent span ID for hierarchy",
      "span_name": "String - Operation name (agent.process_message, openai.chat, etc.)",
      "span_kind": "Enum - INTERNAL, CLIENT, SERVER, PRODUCER, CONSUMER",
      "start_time": "ISO 8601 timestamp - Span start",
      "end_time": "ISO 8601 timestamp - Span end",
      "duration_ms": "Integer - Duration in milliseconds",
      "status_code": "Enum - OK, ERROR, UNSET",
      "status_message": "String or null - Error message if status is ERROR",
      "session_id": "UUID (string) - Session identifier (JOIN KEY with platform_events)",
      "attributes": "JSON object - Span attributes (GenAI conventions, custom attrs)"
    },
    "join_key": "session_id is the primary join key for combining platform events and agent traces"
  },
  "genai_semantic_conventions": {
    "gen_ai.system": "LLM provider (e.g., 'openai', 'anthropic')",
    "gen_ai.request.model": "Model name (e.g., 'gpt-4o-mini')",
    "gen_ai.request.temperature": "Sampling temperature (0.0-2.0)",
    "gen_ai.request.max_tokens": "Max tokens requested",
    "gen_ai.usage.input_tokens": "Number of input/prompt tokens",
    "gen_ai.usage.output_tokens": "Number of output/completion tokens",
    "gen_ai.usage.total_tokens": "Total tokens (input + output)",
    "gen_ai.response.finish_reason": "Why generation stopped (e.g., 'stop', 'length', 'content_filter')",
    "gen_ai.response.id": "LLM response ID"
  },
  "custom_attributes": {
    "user_id": "User identifier (for filtering/grouping)",
    "message_length": "Length of user message in characters",
    "agent.task_created": "Boolean - Whether agent created a task",
    "agent.needs_clarification": "Boolean - Whether agent needs more info from user",
    "task_extracted": "Boolean - Whether task was successfully extracted from message"
  },
  "example_queries": {
    "recent_events": "SELECT * FROM signaltogrowth.platform_events WHERE event_timestamp >= CURRENT_TIMESTAMP - INTERVAL 1 HOUR ORDER BY event_timestamp DESC LIMIT 10",
    "recent_traces": "SELECT * FROM signaltogrowth.agent_traces WHERE timestamp >= CURRENT_TIMESTAMP - INTERVAL 1 HOUR ORDER BY start_time DESC LIMIT 10",
    "session_timeline": "SELECT e.event_name, e.event_timestamp, t.span_name, t.duration_ms FROM signaltogrowth.platform_events e LEFT JOIN signaltogrowth.agent_traces t ON e.session_id = t.session_id WHERE e.session_id = 'sess_abc123-def456-789012' ORDER BY e.event_timestamp",
    "token_usage_by_session": "SELECT session_id, SUM(attributes.gen_ai_usage_total_tokens) as total_tokens FROM signaltogrowth.agent_traces WHERE timestamp >= CURRENT_DATE GROUP BY session_id ORDER BY total_tokens DESC LIMIT 10",
    "agent_latency_analysis": "SELECT e.session_id, e.event_name, t.span_name, t.duration_ms FROM signaltogrowth.platform_events e INNER JOIN signaltogrowth.agent_traces t ON e.session_id = t.session_id WHERE e.event_name = 'agent_message_sent' AND t.span_name = 'agent.process_message' ORDER BY t.duration_ms DESC LIMIT 20"
  }
}
